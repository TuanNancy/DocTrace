# Keep text files LF across Windows, macOS and Linux; preserve binary bytes.

* text=auto

*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.sh      text eol=lf
*.mts     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
*.example text eol=lf

Dockerfile       text eol=lf
.env             text eol=lf
.env.example     text eol=lf
.gitignore       text eol=lf
.dockerignore    text eol=lf
.gitattributes   text eol=lf

# Never diff or convert binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
