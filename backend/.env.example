# Required when calling chat/embeddings: key and the corresponding model.
# Model IDs below are examples, not automatic fallbacks; select available models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=64
UPSTREAM_TIMEOUT_SECONDS=60
# Hard cap on paid summary/reduction calls for one long document overview.
SUMMARY_MAX_CALLS=8

# Optional exact-answer cache. Use a SEPARATE Redis instance/database from
# REDIS_URL; empty disables caching. A hit still consumes one admitted question.
ANSWER_CACHE_URL=
ANSWER_CACHE_TTL_SECONDS=259200

# Routing is opt-in. Free requests use CHEAP_MODEL when enabled; pro requests
# keep RAG_MODEL for complex/overview work. Set prices for the models you use.
MODEL_ROUTING_ENABLED=false
CHEAP_MODEL=
COMPLEX_QUERY_WORDS=30
# Worst-case generation budget per request, integer micro-USD. 0 disables.
# Prices are micro-USD per million tokens and MUST match the selected models.
REQUEST_COST_CAP_MICROS=100000
MODEL_INPUT_MICROS_PER_MTOK=150000
MODEL_OUTPUT_MICROS_PER_MTOK=600000
CHEAP_INPUT_MICROS_PER_MTOK=150000
CHEAP_OUTPUT_MICROS_PER_MTOK=600000

# Local Milvus. Use a NEW owner-scoped collection; old PDFs must be re-uploaded.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=pdf_chunks_owned_v1

# Zilliz: set both values below. AUTOINDEX is selected automatically for URI mode.
# For local mode, leave them empty; IVF_FLAT is selected automatically.
MILVUS_URI=
MILVUS_TOKEN=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for the document library. Create a private bucket in Supabase first.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-2
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=pdfs

# Control-plane Postgres (Supabase): use the dedicated doctrace_app login.
# Store DDL credentials separately in .env.migrations (see its example).
# The doctrace schema is never exposed through the Data API.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# JSON logs are recommended in production. Request IDs are accepted from
# X-Request-ID and always returned to the client.
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=documents-v2
DOCUMENT_INDEX_TIMEOUT_SECONDS=900
DOCUMENT_DELETE_TIMEOUT_SECONDS=300

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_SIZE_MB=50
# Per-process limits. Production runs one worker on the small EC2 instance.
UPLOAD_MAX_CONCURRENT=1
# Per-user sliding windows shared by all API processes through REDIS_URL.
# Admitted attempts count even if subsequent processing fails; restart API after edits.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
RATE_LIMIT_CHAT_REQUESTS=10
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_INDEX_RETRY_REQUESTS=3
RATE_LIMIT_INDEX_RETRY_WINDOW_SECONDS=600
MAX_CHUNKS_PER_DOCUMENT=2000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
CONTEXT_MAX_CHARS=12000
MIN_RELEVANCE_SCORE=0.32

# Optional tuning values above override AppConfig defaults. Restart after edits.
# Embedding dimensions are detected from actual vectors, not configured here.
