# Required when calling chat/embeddings: key and the corresponding model.
# Model IDs below are examples, not automatic fallbacks; select available models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=64
UPSTREAM_TIMEOUT_SECONDS=60

# Local Milvus. Use a NEW owner-scoped collection; old PDFs must be re-uploaded.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=pdf_chunks_owned_v1

# Zilliz: set both values below. AUTOINDEX is selected automatically for URI mode.
# For local mode, leave them empty; IVF_FLAT is selected automatically.
MILVUS_URI=
MILVUS_TOKEN=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for metadata/outbox. Apply migrations 001 then 002.
SUPABASE_SERVICE_ROLE_KEY=
# Required for the document library. Create a private bucket in Supabase first.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-2
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=pdfs
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=documents
DOCUMENT_INDEX_TIMEOUT_SECONDS=900
DOCUMENT_DELETE_TIMEOUT_SECONDS=300
DOCUMENT_DISPATCH_POLL_SECONDS=2

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_SIZE_MB=50
# Per-process limits. Production runs one worker on the small EC2 instance.
UPLOAD_MAX_CONCURRENT=1
MAX_CHUNKS_PER_DOCUMENT=2000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
CONTEXT_MAX_CHARS=12000
MIN_RELEVANCE_SCORE=0.32

# Optional tuning values above override AppConfig defaults. Restart after edits.
# Embedding dimensions are detected from actual vectors, not configured here.
