# First issuance only: serve HTTP-01 challenges without exposing the API over HTTP.
include /opt/doctrace/privacy.conf;

server {
    listen 80;
    server_name ${API_DOMAIN};
    access_log /dev/stdout doctrace_safe;
    add_header X-Request-ID $doctrace_request_id always;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 503 "HTTPS setup in progress.\n";
    }
}
