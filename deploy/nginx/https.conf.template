# Docker DNS re-resolves the API after its container is recreated (Nginx 1.28+).
resolver 127.0.0.11 valid=10s ipv6=off;
upstream api_backend {
    zone api_backend 64k;
    server api:8000 resolve;
    keepalive 16;
}

server {
    listen 80;
    server_name ${API_DOMAIN};

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${API_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/doctrace/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/doctrace/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Multipart overhead above FastAPI's default 50 MiB PDF limit.
    client_max_body_size 55m;
    client_body_timeout 60s;

    location / {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nginx is the public edge: discard client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep PDF requests and SSE responses streaming end to end.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_ignore_client_abort off;
        proxy_connect_timeout 10s;
        # Inactivity between upstream reads, not a total request duration.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
