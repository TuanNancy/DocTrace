# DNS must point this domain to the VPS public address; open inbound TCP 80/443.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Default fails closed without a certificate. Bootstrap script temporarily uses http.
TLS_MODE=https

# Optional: API image tag, backend env file and host port bindings.
# deploy/deploy.sh manages API_IMAGE after enabling CD; keep its recorded tag.
# API_IMAGE=doctrace-api:local
# Set only if the existing production stack uses a custom Compose project name.
# COMPOSE_PROJECT_NAME=doctrace
# BACKEND_ENV_FILE=./backend/.env
# NGINX_BIND_ADDRESS=0.0.0.0
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
