# Public Supabase project settings (never use a service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth Web Client ID, also configured in Supabase's Google provider.
# Authorize the frontend origin in Google Cloud. No client secret belongs here.
# Leave empty to use email/password only. Rebuild after setting this value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Leave empty for simulated upload/chat. Authentication still uses Supabase.
NEXT_PUBLIC_API_URL=http://localhost:8000
